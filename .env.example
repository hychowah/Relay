RELAY_PROVIDER=fixture
DEEPSEEK_MODEL=deepseek-flash
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_MODEL=gpt-6.2-sol
# Provider settings saved in the UI override these startup defaults.
# Live modes require a connected NordVPN client unless RELAY_VPN_CHECK=off.
# Keys are separate per provider. Keep them in private files, never in source.
# DEEPSEEK_API_KEY_FILE=/absolute/path/to/deepseek_api_key
# ANTHROPIC_API_KEY_FILE=/absolute/path/to/anthropic_api_key
# OPENAI_API_KEY_FILE=/absolute/path/to/openai_api_key

# Native apps: copy apps.example.json and set addresses reachable by Relay.
# Optional browserUrl in each registration overrides the browser's app origin.
# RELAY_APPS_FILE=runtime/apps.json

# Leave RELAY_APPS_FILE unset to start without registered apps.

PORT=3210
RELAY_HOST=127.0.0.1
RELAY_DATA_DIR=runtime
