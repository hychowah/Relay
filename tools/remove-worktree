#!/usr/bin/env python3
"""Remove a feature worktree and retire its branch's published Flutter previews."""
import fcntl
import json
from pathlib import Path
import re
import subprocess
import sys


def main():
    if len(sys.argv) != 2:
        sys.exit("Usage: tools/remove-worktree <worktree-path>")
    target = Path(sys.argv[1]).resolve()
    branch = subprocess.check_output(
        ["git", "-C", target, "branch", "--show-current"], text=True
    ).strip()
    if not branch or branch == "main":
        sys.exit("Choose a feature worktree on a branch.")
    remove = ["git", "worktree", "remove", "--", target]
    setting = subprocess.check_output(
        ["git", "-C", target, "config", "--default", "", "--get", "relay.flutterReleases"],
        text=True,
    ).strip()
    releases = Path(setting)
    if setting and not releases.is_absolute():
        sys.exit("Use an absolute relay.flutterReleases path shared by all worktrees.")
    if not setting or not releases.exists():
        subprocess.run(remove, check=True)
        return

    with (releases / ".preview.lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        retired = {}
        retained = set()
        for path in releases.iterdir():
            if not re.fullmatch(r"preview-[a-z0-9][a-z0-9-]{0,62}\.json", path.name):
                continue
            manifest = json.loads(path.read_text())
            if manifest["branch"] == branch:
                retired[path] = manifest["file"]
            else:
                retained.add(manifest["file"])

        subprocess.run(remove, check=True)
        for path in retired:
            path.unlink()
        for filename in set(retired.values()) - retained:
            if re.fullmatch(r"Relay-Flutter-preview-[0-9a-f]{64}\.zip", filename):
                (releases / filename).unlink(missing_ok=True)
        print(f"Retired {len(retired)} preview(s) for {branch}.")


if __name__ == "__main__":
    try:
        main()
    except subprocess.CalledProcessError as error:
        sys.exit(error.returncode)
