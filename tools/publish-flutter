#!/usr/bin/env python3
"""Build this checkout's Flutter client on the Mac and publish it as a named test build or as Stable.

The Mac build runs in a temporary folder that is removed afterwards, so
publishing leaves nothing on the Mac."""
import fcntl
import gzip
import hashlib
import io
import json
import os
from pathlib import Path
import plistlib
import re
import shlex
import stat
import subprocess
import sys
import tarfile
import tempfile
import uuid
import zipfile

import preview_feed


def git(*args):
    return subprocess.check_output(["git", *args], text=True).strip()


def main():
    stable = sys.argv[1:] == ["--stable"]
    if not stable and (len(sys.argv) != 2 or not re.fullmatch(r"[a-z0-9][a-z0-9-]{0,62}", sys.argv[1])):
        sys.exit("Usage: tools/publish-flutter <lowercase-name> | --stable")
    name = None if stable else sys.argv[1]
    os.chdir(git("rev-parse", "--show-toplevel"))
    # Local git config is shared by all linked worktrees.
    try:
        ssh = git("config", "--get", "relay.macSSH")
        releases = Path(git("config", "--get", "relay.flutterReleases"))
    except subprocess.CalledProcessError:
        sys.exit("Set relay.macSSH and relay.flutterReleases in local git config (see flutter/README.md).")
    if not releases.is_absolute():
        sys.exit("Use an absolute relay.flutterReleases path shared by all worktrees.")
    releases.mkdir(parents=True, exist_ok=True)
    branch = git("rev-parse", "--abbrev-ref", "HEAD")
    commit = git("rev-parse", "HEAD")
    if stable:
        # Stable records its commit, which later decides the test builds it contains.
        if git("status", "--porcelain", "--", "flutter"):
            sys.exit("Commit the Flutter changes first: Stable records the commit it was built from.")
        version = re.search(r"^version: (\d+\.\d+\.\d+)", Path("flutter/pubspec.yaml").read_text(), re.M)[1]
        filename = f"Relay-Flutter-{version}-macOS-arm64.zip"
        published = "This version is already published. Increase the version in flutter/pubspec.yaml first."
        if (releases / filename).exists():
            sys.exit(published)
        flags = []
        identity = ("CFBundleShortVersionString", version)
    else:
        if branch == "HEAD":
            sys.exit("Check out a branch first: a test build is retired through its branch or its commit.")
        dirty = bool(git("status", "--porcelain"))
        build = str(uuid.uuid4().int % 10**15)
        flags = [f"--build-number={build}", f"--dart-define=RELAY_PREVIEW={name}"]
        identity = ("CFBundleVersion", build)
    remote = subprocess.check_output([ssh, "mktemp -d /tmp/relay-build.XXXXXXXX"], text=True).strip()
    if not re.fullmatch(r"/tmp/relay-build\.[A-Za-z0-9]+", remote):
        sys.exit("Mac did not return a build directory")
    try:
        with tempfile.TemporaryDirectory(dir=releases) as stage:
            stage = Path(stage)
            # Snapshot only repository source, including uncommitted Flutter edits.
            paths = subprocess.check_output(["git", "ls-files", "-z", "--cached", "--others", "--exclude-standard", "--", "flutter"])
            with tempfile.TemporaryFile() as snapshot:
                with tarfile.open(fileobj=snapshot, mode="w:gz") as tar:
                    for path in filter(None, map(os.fsdecode, paths.split(b"\0"))):
                        if not os.path.lexists(path):
                            continue
                        if name and path == "flutter/macos/Runner/Info.plist":
                            info = plistlib.loads(Path(path).read_bytes())
                            if info.get("RelayUpdateFormat") != "1":
                                sys.exit("Bring the preview-capable updater into this worktree before publishing.")
                            info["RelayPreview"] = name
                            data = plistlib.dumps(info)
                            entry = tarfile.TarInfo(path)
                            entry.size = len(data)
                            tar.addfile(entry, io.BytesIO(data))
                        else:
                            tar.add(path, recursive=False)
                snapshot.seek(0)
                subprocess.run([ssh, f"tar -xzf - -C {remote}"], stdin=snapshot, check=True)
            # The app has no built-in server address: the environment or local git config supplies it.
            addresses = {"RELAY_URL": "relay.appUrl", "RELAY_UPDATE_URL": None}
            for key, setting in addresses.items():
                value = os.environ.get(key)
                if not value and setting:
                    try:
                        value = git("config", "--get", setting)
                    except subprocess.CalledProcessError:
                        sys.exit(f"Set {key} or `git config --local {setting}` to the address the app must use.")
                if value:
                    flags.append(f"--dart-define={key}={value}")
            cmd = f"""set -eu
export DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer
export PATH="$HOME/Developer/relay-flutter-experiment/sdk/bin:$PATH"
cd {remote}/flutter
flutter build macos --release {shlex.join(flags)}
bundle="build/macos/Build/Products/Release/Relay Flutter.app"
codesign --verify --strict --deep "$bundle"
ditto -c -k --sequesterRsrc --keepParent "$bundle" {remote}/release.zip"""
            subprocess.run([ssh, cmd], check=True)
            archive = stage / "release.zip"
            with archive.open("wb") as output:
                subprocess.run([ssh, f"cat {remote}/release.zip"], stdout=output, check=True)
            with zipfile.ZipFile(archive) as package:
                info = plistlib.loads(package.read("Relay Flutter.app/Contents/Info.plist"))
            built = (info.get("CFBundleIdentifier"), info.get("RelayPreview"), info.get(identity[0]))
            if built != ("app.relay.flutterExperiment", name, identity[1]):
                sys.exit("The archive does not identify the requested build")
            with archive.open("rb") as source:
                digest = hashlib.file_digest(source, "sha256").hexdigest()
            mac_digest = subprocess.check_output([ssh, f"shasum -a 256 {remote}/release.zip"], text=True).split()[0]
            if mac_digest != digest:
                sys.exit("The transferred archive differs from the signed Mac build.")
            size = archive.stat().st_size
            # Compress each file outside the lock; the lock only covers moving them in.
            packed = stage / preview_feed.STORE
            packed.mkdir()
            entries = []
            with zipfile.ZipFile(archive) as package:
                for item in package.infolist():
                    path = item.filename.removeprefix("Relay Flutter.app/")
                    mode = item.external_attr >> 16
                    if item.filename == path:
                        sys.exit(f"Unexpected archive entry: {item.filename}")
                    if item.is_dir():
                        continue
                    data = package.read(item)
                    if stat.S_ISLNK(mode):
                        entries.append(dict(path=path, link=data.decode()))
                        continue
                    content = hashlib.sha256(data).hexdigest()
                    (packed / f"{content}.gz").write_bytes(gzip.compress(data, mtime=0))
                    entries.append(dict(path=path, sha256=content, size=len(data), exec=bool(mode & 0o111)))
            if stable:
                manifest = dict(version=version, file=filename, size=size, sha256=digest, commit=commit)
            else:
                filename = f"Relay-Flutter-preview-{digest}.zip"
                manifest = dict(name=name, branch=branch, commit=commit, dirty=dirty,
                                version=info["CFBundleShortVersionString"], build=build,
                                file=filename, sha256=digest, size=size)
            metadata = stage / "manifest.json"
            with (releases / preview_feed.LOCK).open("a") as lock:
                fcntl.flock(lock, fcntl.LOCK_EX)
                # The worktree may have been retired during the Mac build.
                if not Path(".git").exists():
                    sys.exit("The source worktree was removed during the build.")
                if stable and (releases / filename).exists():
                    sys.exit(published)
                store = releases / preview_feed.STORE
                store.mkdir(exist_ok=True)
                for blob in packed.iterdir():
                    if not (store / blob.name).exists():
                        blob.replace(store / blob.name)
                for entry in entries:
                    if "sha256" in entry:
                        entry["packed"] = (store / f"{entry['sha256']}.gz").stat().st_size
                listing = json.dumps(entries).encode()
                listed = gzip.compress(listing, mtime=0)
                manifest["fileList"] = dict(sha256=hashlib.sha256(listing).hexdigest(), size=len(listing), packed=len(listed))
                (packed / "list.gz").write_bytes(listed)
                (packed / "list.gz").replace(store / f"{manifest['fileList']['sha256']}.gz")
                metadata.write_text(json.dumps(manifest) + "\n")
                if stable:
                    archive.replace(releases / filename)
                    metadata.replace(releases / "latest.json")
                    # A test build whose commit Stable contains has nothing left to offer.
                    retired = preview_feed.retire(releases, lambda preview: not preview.get("dirty") and subprocess.run(
                        ["git", "merge-base", "--is-ancestor", preview["commit"], commit],
                        stderr=subprocess.DEVNULL).returncode == 0)
                    print(f"Published Stable {version} ({commit[:8]}, {digest[:8]}); retired {retired} test build(s) it contains.")
                else:
                    archive.replace(releases / filename)
                    metadata.replace(releases / f"preview-{name}.json")
                    preview_feed.prune(releases)
                    print(f"Published {name} ({branch} {commit[:8]}, {digest[:8]})")
    finally:
        subprocess.run([ssh, f"rm -rf {remote}"], check=False)


if __name__ == "__main__":
    main()
