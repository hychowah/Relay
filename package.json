{
  "name": "relay",
  "version": "0.1.7",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.9.0 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env server/index.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "check:records": "python3 tools/check_records.py",
    "perf": "node --import tsx tools/perf.ts",
    "perf:ui": "node --import tsx tools/perf-ui.ts",
    "test:mac": "node --import tsx tools/mac-test.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.8",
    "@opencode/cli": "2.3.0",
    "@opencode/plugin": "2.3.0",
    "effect": "4.1.0",
    "hono": "4.13.18",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "ws": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cheerio": "1.2.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "playwright": "1.65.1",
    "@types/ws": "8.18.2"
  },
  "allowScripts": {
    "@opencode/cli@2.3.0": true
  }
}
